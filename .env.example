# .env.example — every configuration key with meaning and default
# Copy to .env for local development:  cp .env.example .env
# Never commit .env — it is in .gitignore.
#
# Keys marked REQUIRED must be set. Keys with a default may be omitted.

# ─── Application ─────────────────────────────────────────────────────────────

# REQUIRED: Deployment environment.
# One of: local | test | staging | production
# In staging/production, KILL_SWITCH_ENABLED must also be true.
APP_ENVIRONMENT=local

# ─── Database ────────────────────────────────────────────────────────────────

# REQUIRED: Postgres connection URL.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://ladywalk:ladywalk_dev@localhost:5432/ladywalk

# Maximum connections in the pool. Default: 10.
DATABASE_MAX_CONNECTIONS=10

# ─── HTTP server ─────────────────────────────────────────────────────────────

# Bind address. Default: 0.0.0.0
SERVER_HOST=0.0.0.0

# Port to listen on. Default: 8080
SERVER_PORT=8080

# Graceful shutdown drain timeout in seconds (F-009 / Q56).
# The service waits this long for in-flight requests to complete before
# forcing exit. Default: 30
SERVER_SHUTDOWN_TIMEOUT_SECS=30

# ─── Redis ───────────────────────────────────────────────────────────────────

# Redis connection URL for kill-switch and rate-limiting.
# Default: redis://localhost:6379
REDIS_URL=redis://:ladywalk_dev@localhost:6379

# ─── Kill switch (Q35) ───────────────────────────────────────────────────────

# SAFETY-CRITICAL: must be true in staging and production.
# A false value in a non-local environment is a startup error.
# Default: false (local only)
KILL_SWITCH_ENABLED=false

# Redis key that, when SET, halts all money movement.
# Default: ladywalk:kill_switch
KILL_SWITCH_REDIS_KEY=ladywalk:kill_switch

# ─── Observability ───────────────────────────────────────────────────────────

# Log level filter. Supports env_filter syntax:
#   info                   — all crates at info
#   debug,sqlx=warn        — debug except sqlx
# Default: info
LOG_LEVEL=info

# Emit structured JSON logs.
# Set true in staging/production for log aggregation.
# Set false locally for human-readable output.
# Default: false
JSON_LOGS=false

# ─── SQLX ────────────────────────────────────────────────────────────────────

# Use committed .sqlx/ metadata for compile-time query checking.
# Must be true in CI (no live database at compile time).
# Default: false (locally, a live database is used)
SQLX_OFFLINE=false
